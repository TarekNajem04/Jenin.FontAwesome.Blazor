<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- Fixture host (never packed): renders adapted icons through the real
         MudBlazor and Blazorise components. FA CSS for the MudBlazor slot is served from the
         vendored tree via FA_VENDOR_DIR (test-only; nothing is copied or committed). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SuiteAdapters</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\..\src\Jenin.FontAwesome.Blazor\Jenin.FontAwesome.Blazor.csproj" />
        <ProjectReference Include="..\..\..\..\src\Jenin.FontAwesome.Blazor.MudBlazor\Jenin.FontAwesome.Blazor.MudBlazor.csproj" />
        <ProjectReference Include="..\..\..\..\src\Jenin.FontAwesome.Blazor.Blazorise\Jenin.FontAwesome.Blazor.Blazorise.csproj" />
        <PackageReference Include="Blazorise.Bootstrap5" />
        <PackageReference Include="Blazorise.Icons.FontAwesome" />
    </ItemGroup>

</Project>
