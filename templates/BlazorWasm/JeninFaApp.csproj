<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>JENIN_TFM</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- Font Awesome components for Blazor. Static asset tags are wired in wwwroot/index.html. -->
        <PackageReference Include="Jenin.FontAwesome.Blazor" Version="JENIN_FA_VERSION" />
        <!-- WebAssembly hosting (version tracks the chosen TFM band). -->
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.32" Condition="'$(TargetFramework)' == 'net8.0'" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.20" Condition="'$(TargetFramework)' == 'net9.0'" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" Condition="'$(TargetFramework)' == 'net10.0'" />
    </ItemGroup>

</Project>
