<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <!-- Declare trimming/AOT compatibility so the linker and analyzers verify this optional package
             independently (publish-level verification, like the other optional packages). -->
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Jenin Blazor Library - Optional self-contained Font Awesome Free inline-SVG icon components for ASP.NET Blazor. Requires no Font Awesome JavaScript, CSS, or webfonts.</Description>
        <PackageId>Jenin.FontAwesome.Blazor.Svg</PackageId>
        <Authors>Tarek Najem</Authors>
        <Company>Jenin</Company>

        <!-- Mixed license: library code is MIT; inlined Font Awesome Free glyph path data is
             CC BY 4.0 (see LICENSES third-party notices + README attribution). The SPDX
             AND expression keeps the machine-readable nuspec accurate instead of MIT-only. -->
        <PackageLicenseExpression>MIT AND CC-BY-4.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/TarekNajem04/Jenin.FontAwesome.Blazor</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReleaseNotes>https://github.com/TarekNajem04/Jenin.FontAwesome.Blazor/releases</PackageReleaseNotes>
        <PackageTags>blazor fontawesome font-awesome-7 icons accessibility a11y trimming aot svg inline-svg wasm components</PackageTags>
        <RepositoryUrl>https://github.com/TarekNajem04/Jenin.FontAwesome.Blazor</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\LICENSES">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\..\icon.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Jenin.FontAwesome.Blazor\Jenin.FontAwesome.Blazor.csproj" />
    </ItemGroup>

</Project>
