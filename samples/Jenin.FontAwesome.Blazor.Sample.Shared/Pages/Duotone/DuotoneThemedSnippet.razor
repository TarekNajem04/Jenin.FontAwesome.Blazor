<div class="mb-1 p-5 d-flex gap-4 align-items-center">
    <IconTheme Palette=DuotonePalettes.Info>
        <Icon IconStyle=IconStyle.Duotone IconName="fa-circle-info" IconSize=IconSize.X03 />
    </IconTheme>
    <IconTheme Palette=DuotonePalettes.Success>
        <Icon IconStyle=IconStyle.Duotone IconName="fa-circle-check" IconSize=IconSize.X03 />
    </IconTheme>
    <IconTheme Palette=DuotonePalettes.Warning>
        <Icon IconStyle=IconStyle.Duotone IconName="fa-triangle-exclamation" IconSize=IconSize.X03 />
    </IconTheme>
    <IconTheme Palette=DuotonePalettes.Danger>
        <Icon IconStyle=IconStyle.Duotone IconName="fa-circle-xmark" IconSize=IconSize.X03 />
    </IconTheme>
    <IconTheme Palette=DuotonePalettes.Info>
        <Icon IconStyle=IconStyle.Duotone IconName="fa-circle-exclamation" IconSize=IconSize.X03 PrimaryColor="#e11d48" />
    </IconTheme>
    <p class="mb-0">Toggle the site theme: the palettes follow light and dark modes.</p>
</div>
