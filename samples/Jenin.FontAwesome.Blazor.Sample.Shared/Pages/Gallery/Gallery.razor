@page "/gallery"

<PageTitle>Gallery — composed screens</PageTitle>

<div class="container-fluid mt-3 mb-4">
    <h1>Gallery</h1>
    <p>
        Composed, realistic screens built only with this library and Bootstrap. Each screen shows
        its own source below the demo, and every one is covered by
        <c>tests/e2e/gallery.spec.ts</c> (desktop layout, mobile viewport, and dark theme).
    </p>

    <div class="list-group">
        <a class="list-group-item list-group-item-action" href="gallery/dashboard">Admin dashboard cards</a>
        <a class="list-group-item list-group-item-action" href="gallery/notifications">Notification center</a>
        <a class="list-group-item list-group-item-action" href="gallery/timeline">File and activity timeline</a>
        <a class="list-group-item list-group-item-action" href="gallery/settings">Settings with toggles</a>
        <a class="list-group-item list-group-item-action" href="gallery/inbox">Inbox with avatars and badges</a>
    </div>
</div>
