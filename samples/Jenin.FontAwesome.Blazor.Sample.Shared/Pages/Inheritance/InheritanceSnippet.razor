<IconContainer CssClass="mb-1 p-5">
    <Icons>
        <HouseIcon @ref=HouseIcon />            @* IconSize = HouseIcon default value *@
        <HouseIcon IconSize=IconSize.NotSet />  @* IconSize = FontAwesome default value *@
        <HouseIcon IconSize=IconSize.X02 />
        <HouseIcon IconSize=IconSize.X03 />
        <HouseIcon IconSize=IconSize.X04 />
        <HouseIcon IconSize=IconSize.X05 />

        <SettingIcon IconSize=IconSize.X05 />
        <SettingIcon IconSize=IconSize.X04 />
        <SettingIcon IconSize=IconSize.X03 />
        <SettingIcon IconSize=IconSize.X02 />
        <SettingIcon IconSize=IconSize.NotSet />    @* IconSize = FontAwesome default value *@
        <SettingIcon @ref=SettingIcon />            @* IconSize = SettingIcon default value *@
    </Icons>
</IconContainer>

@code {
    public HouseIcon HouseIcon { get; set; } = default!;
    public SettingIcon SettingIcon { get; set; } = default!;

