<IconList CssClass="mb-1 p-5" Bordered=true BorderColor="#55ACEE" BorderWidth="2px">
    <Items>
        <IconListItem>
            <ItemIcon>
                <Icon IconStyle=IconStyle.Solid IconName="fa-square"/>
            </ItemIcon>
            <ItemContent>List icons can</ItemContent>
        </IconListItem>

        <IconListItem>
            <ItemIcon>
                <Icon IconStyle=IconStyle.Solid IconName="fa-check-square" />
            </ItemIcon>
            <ItemContent>be used to</ItemContent>
        </IconListItem>

        <IconListItem>
            <ItemIcon>
                <Icon IconStyle=IconStyle.Solid IconName="fa-spinner" Animation=@Animate.Spin(new SpinOptions { Pulse = true }) />
            </ItemIcon>
            <ItemContent>replace bullets</ItemContent>
        </IconListItem>

        <IconListItem>
            <ItemIcon>
                <Icon IconStyle=IconStyle.Regular IconName="fa-square" />
            </ItemIcon>
            <ItemContent>in lists</ItemContent>
        </IconListItem>
    </Items>
</IconList>
