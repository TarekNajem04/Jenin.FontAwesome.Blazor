@using Jenin.FontAwesome.Blazor.IconPicker

<IconPicker @bind-Value="IconName" />

<div class="mt-3 mb-0">
    <p class="mb-2">
        Selected:
        <code>@(string.IsNullOrEmpty(IconName) ? "nothing yet" : IconName)</code>
    </p>

    @if(!string.IsNullOrEmpty(IconName)) {
        <Icon CssClass="me-2" IconSize=IconSize.X03 IconName="@IconName" />
    }
</div>

@code {
    private string? IconName { get; set; }
}
