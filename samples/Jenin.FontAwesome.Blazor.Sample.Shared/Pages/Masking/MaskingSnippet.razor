<IconContainer CssClass="mb-1 p-5" IconSize=IconSize.X04>
    <Icons>
        <Icon IconStyle=IconStyle.Solid
              IconName="fa-pencil-alt"
              Transform=@(new Transform().Shrink(10F).Up(0.5F))
              MaskIconStyle=IconStyle.Solid
              MaskIconName="fa-comment"
              BackgroundColor="#7CBB00"
              Color="#F7F7F7" />

        <Icon IconStyle=IconStyle.Brands
              IconName="fa-facebook-f"
              Transform=@(new Transform().Shrink(3.5F).Down(1.6F).Right(1.25F))
              MaskIconStyle=IconStyle.Solid
              MaskIconName="fa-circle"
              BackgroundColor="#3B5998"
              Color="#F7F7F7" />

        <Icon IconStyle=IconStyle.Solid IconName="fa-headphones"
              Transform=@(new Transform().Shrink(6F))
              MaskIconStyle=IconStyle.Solid
              MaskIconName="fa-square"
              BackgroundColor="#F65314"
              Color="#F7F7F7" />

        <Icon IconStyle=IconStyle.Solid
              IconName="fa-mask"
              Transform=@(new Transform().Shrink(3F).Up(1F))
              MaskIconStyle=IconStyle.Solid
              MaskIconName="fa-circle"
              BackgroundColor="#00A1F1"
              Color="#F7F7F7" />
    </Icons>
</IconContainer>
