@page "/icon-sprites"

<PageTitle>Font Awesome SVG Sprites</PageTitle>

<div class="sprites-page sample-page">
    <div class="container-fluid mt-3 mb-5">
        <div class="mt-4 p-5 bg-success text-white rounded">
            <span class="badge bg-light text-dark">No JavaScript required</span>
            <h1>Font Awesome SVG Sprites</h1>
            <p>
                Every glyph below is a native <code>&lt;svg&gt;&lt;use&gt;</code> reference into a
                single self-hosted sprite (<code>fa-sprite.svg</code>, generated by
                <code>eng/fa_sprite.py</code>). Disable the Font Awesome JavaScript entirely and
                they still render — ideal for strict Content Security Policies and offline pages.
            </p>
        </div>
    </div>
    <SampleTabs>
        <Tabs>
            <SampleTab Text="Blazor">
                <Samples>
                    <Sample CssClass="mb-5" SnippetComponent=typeof(SpritesBasicSnippet) Heading="Sprite Icons" />
                    <Sample CssClass="mb-5" SnippetComponent=typeof(SpritesThemedSnippet) Heading="Sizes and Colors" />
                    <Sample CssClass="mb-5" SnippetComponent=typeof(SpritesGeneratedSnippet) Heading="Generated Components" />
                </Samples>
            </SampleTab>
        </Tabs>
    </SampleTabs>
</div>
