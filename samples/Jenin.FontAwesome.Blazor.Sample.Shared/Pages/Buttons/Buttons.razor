@page "/icon-buttons"

<PageTitle>Font Awesome Icon Buttons</PageTitle>

<div class="buttons-page sample-page">
    <SampleTabs>
        <Tabs>
            <SampleTab Text="Blazor">
                <Samples>
                    <Sample CssClass="mb-5" SnippetComponent=typeof(IconButtonsBasicSnippet) Heading="Buttons" />
                    <Sample CssClass="mb-5" SnippetComponent=typeof(IconButtonsBusySnippet) Heading="Busy State" />
                    <Sample CssClass="mb-5" SnippetComponent=typeof(IconToggleButtonsSnippet) Heading="Toggle & Favorite" />
                </Samples>
            </SampleTab>

            <SampleTab Text="HTML">
                <Samples>
                    <Sample CssClass="mb-5" SnippetComponent=typeof(IconButtonsHtmlSnippet) Heading="Buttons" />
                </Samples>
            </SampleTab>
        </Tabs>
    </SampleTabs>
</div>
