<IconContainer CssClass="mb-1 p-5 d-flex gap-3 align-items-center" IconSize=IconSize.X02>
    <Icons>
        <IconButton IconName="fa-floppy-disk" IconStyle=IconStyle.Solid Label="Save" Busy=true />
        <IconButton IconName="fa-cloud-arrow-up" IconStyle=IconStyle.Solid Label="Upload" Busy=@IsBusy OnClick=UploadAsync />
    </Icons>
</IconContainer>

@code {
    private bool IsBusy;

    private async Task UploadAsync() {
        IsBusy = true;

        try {
            await Task.Delay(TimeSpan.FromSeconds(2));
        }
        finally {
            IsBusy = false;
        }
    }
}
