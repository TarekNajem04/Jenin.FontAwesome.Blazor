<IconContainer CssClass="mb-1 p-5 d-flex gap-3 align-items-center">
    <Icons>
        <IconToggleButton IconName="fa-heart" IconStyle=IconStyle.Regular Label="Like" PressedIconStyle=IconStyle.Solid PressedColor="red" @bind-Pressed=IsLiked />
        <span>@(IsLiked ? "Liked!" : "Not liked yet")</span>
    </Icons>
</IconContainer>

@code {
    private bool IsLiked;
}
