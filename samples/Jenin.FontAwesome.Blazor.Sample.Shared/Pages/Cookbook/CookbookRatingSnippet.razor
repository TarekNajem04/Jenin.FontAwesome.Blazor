<IconContainer CssClass="mb-1 p-5 d-flex gap-3 align-items-center">
    <Icons>
        <IconRating @bind-Value=Rating Max=5 RatingLabel="Rate this sample" />
        <span>Your rating: @Rating.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)</span>
    </Icons>
</IconContainer>

@code {
    private float Rating = 4;
}
