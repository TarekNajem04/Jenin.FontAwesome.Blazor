<IconContainer CssClass="mb-1 p-5 d-flex gap-4 align-items-center" IconSize=IconSize.X02>
    <Icons>
        <Icon IconName="fa-bell" IconStyle=IconStyle.Solid Animation=@Animate.Shake() Trigger=AnimationTrigger.Hover Title="Hover me" />
        <Icon IconName="fa-star" IconStyle=IconStyle.Solid Animation=@Animate.Spin() Trigger=AnimationTrigger.Focus Title="Tab to me, then focus" />
    </Icons>
</IconContainer>
