<IconContainer CssClass="mb-1 ps-4" IconSize=IconSize.X03>
    <Icons>
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-person-digging"
              Animation=@Animate.BeatFade()
              Color="#793029" />

        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-heart-circle-exclamation"
              Animation=@Animate.BeatFade()
              Color="#E32934" />

        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-poo-bolt"
              Animation=@Animate.BeatFade(new BeatFadeOptions { Opacity = 0.1F, Scale = 1.25F })
              Color="var(--bs-warning)" />

        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-circle-info"
              Animation=@Animate.BeatFade(new BeatFadeOptions { Opacity = 0.67F, Scale = 1.075F })
              Color="#E32934" />
    </Icons>
</IconContainer>
