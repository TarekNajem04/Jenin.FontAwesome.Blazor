<IconContainer CssClass="mb-1 ps-4" IconSize=IconSize.X03>
    <Icons>
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-sync"          Animation=@Animate.Spin() Color="#007AFF" data-testid="always-on-spin" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-circle-notch"  Animation=@Animate.Spin() Color="#007AFF" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-cog"           Animation=@Animate.Spin() Color="#007AFF" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-cog"           Animation=@Animate.Spin(new SpinOptions { Reverse = true }) Color="#007AFF" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-spinner"       Animation=@Animate.Spin(new SpinOptions { Pulse = true }) Color="#007AFF" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-spinner"       Animation=@Animate.Spin(new SpinOptions { Pulse = true, Reverse = true }) Color="#007AFF" />
    </Icons>
</IconContainer>
