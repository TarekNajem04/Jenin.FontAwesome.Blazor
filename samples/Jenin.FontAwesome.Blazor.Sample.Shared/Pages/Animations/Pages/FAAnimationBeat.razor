@page "/animation-beat"

<PageTitle>Font Awesome Animation Beat</PageTitle>

<IconContainer CssClass="mb-1" IconSize=IconSize.X03>
    <Icons>
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-circle-plus" Animation=@Animate.Beat()                                                           Color="#007AFF" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-heart"       Animation=@Animate.Beat()                                                           Color="#E32934" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-heart"       Animation=@Animate.Beat(new BeatOptions { Duration = TimeSpan.FromMilliseconds(500) }) Color="#E32934" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-heart"       Animation=@Animate.Beat(new BeatOptions { Duration = TimeSpan.FromSeconds(2) })        Color="#E32934" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-heart"       Animation=@Animate.Beat(new BeatOptions { Scale = 2.0F })                                                Color="#E32934" />
    </Icons>
</IconContainer>
