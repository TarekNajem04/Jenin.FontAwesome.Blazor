@page "/animation-shake"

<PageTitle>Font Awesome Animation Shake</PageTitle>


<IconContainer CssClass="mb-1" FixedWidth=false IconSize=IconSize.X03>
    <Icons>
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-bell" Animation=@Animate.Shake() Color="#007AFF" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-lock" Animation=@Animate.Shake() Color="#007AFF" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-stopwatch" Animation=@Animate.Shake() Color="#007AFF" />
        <Icon CssClass="me-4" IconStyle=IconStyle.Solid IconName="fa-bomb" Animation=@Animate.Shake() Color="#007AFF" />
    </Icons>
</IconContainer>
