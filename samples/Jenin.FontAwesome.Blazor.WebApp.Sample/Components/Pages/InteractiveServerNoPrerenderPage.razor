@page "/interactive-server-no-prerender"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Interactive Server (no prerender)</PageTitle>

<h1>Interactive Server (no prerender)</h1>

<p>
    This page disables prerendering, so the markup is not produced until the circuit is connected.
    The icons appear once the interactive server renderer runs.
</p>

<FeatureShowcase />
