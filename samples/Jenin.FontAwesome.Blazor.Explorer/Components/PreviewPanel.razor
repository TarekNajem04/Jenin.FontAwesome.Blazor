@if (Selected is null) {
    <div class="explorer-preview explorer-preview--empty">
        <p class="explorer-preview__empty-title">No icon selected</p>
        <p class="explorer-preview__empty-hint">Choose an icon from the grid to see its details.</p>
    </div>
} else {
    <div class="explorer-preview">
        <div class="explorer-preview__sticky">
            <UnsupportedNotice Style="@Preview.Style"
                               Typeface="@Preview.Typeface"
                               WebFontMode="@WebFontMode"
                               UsesSvgOnlyFeature="@UsesSvgOnlyFeature" />
            <div class="explorer-preview__canvas" aria-hidden="true">
                <Icon IconName="@Selected.CssClass"
                      IconStyle="@Preview.Style"
                      Typeface="@Preview.Typeface"
                      IconSize="@Preview.Size"
                      WidthMode="@Preview.WidthMode"
                      FixedWidth="@Preview.FixedWidth"
                      Color="@ColorValue"
                      BackgroundColor="@BackgroundColorValue"
                      Rotate="@Preview.Rotate"
                      RotateAngle="@RotateAngle"
                      CombiningRotate="@Preview.CombiningRotate"
                      PullPosition="@Preview.PullPosition"
                      Bordered="@Preview.Bordered"
                      Inverse="@Preview.Inverse"
                      SwapOpacity="@Preview.SwapOpacity"
                      PrimaryColor="@PrimaryColor"
                      SecondaryColor="@SecondaryColor"
                      PrimaryOpacity="@PrimaryOpacity"
                      SecondaryOpacity="@SecondaryOpacity"
                      MaskIconName="@MaskIconName"
                      MaskIconStyle="@Preview.MaskIconStyle"
                      Animation="@CurrentAnimation"
                      Transform="@CurrentTransform" />
            </div>
            <dl class="explorer-preview__meta">
                <dt>Class</dt>
                <dd class="explorer-preview__class"><code>@Selected.CssClass</code></dd>
                <dt>Label</dt>
                <dd>@Selected.Label</dd>
                <dt>Free styles</dt>
                <dd>@StyleSummary</dd>
            </dl>
        </div>
        <div class="explorer-preview__scroll">
            <PreviewControls State="@Preview" OnChanged="StateHasChanged" />
            <SnippetPanel @ref="_snippets" Selected="@Selected" Preview="@Preview" />
            <p class="explorer-preview__attribution">
                Icon metadata © Font Awesome (<a href="https://fontawesome.com" target="_blank" rel="noopener noreferrer">fontawesome.com</a>),
                licensed CC BY 4.0.
                <a href="@FontAwesomeLink" target="_blank" rel="noopener noreferrer">View @Selected.Name on fontawesome.com</a>.
            </p>
        </div>
    </div>
}
