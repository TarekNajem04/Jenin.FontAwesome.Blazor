@if (Messages.Count > 0) {
    <div class="explorer-notice" role="status" aria-live="polite">
        @foreach (var message in Messages) {
            <p class="explorer-notice__item">
                <span class="explorer-notice__badge" aria-hidden="true">@message.Badge</span>
                <span class="explorer-notice__text">@message.Text</span>
            </p>
        }
    </div>
}
