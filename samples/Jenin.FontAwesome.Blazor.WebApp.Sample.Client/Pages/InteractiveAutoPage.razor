@page "/interactive-auto"
@rendermode InteractiveAuto

<PageTitle>Interactive Auto</PageTitle>

<h1>Interactive Auto</h1>

<p>
    Interactive Auto chooses the best available host. The first visit is rendered interactively by the
    server while the WebAssembly runtime downloads in the background; later visits run the same
    component interactively in the browser. The output is identical in both cases.
</p>

<FeatureShowcase />
